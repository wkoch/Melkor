source "$BR2_EXTERNAL_MELKOR_PATH/package/dinit/Config.in"
source "$BR2_EXTERNAL_MELKOR_PATH/package/dnsproxy/Config.in"
source "$BR2_EXTERNAL_MELKOR_PATH/package/melkor-dhcpcd/Config.in"
source "$BR2_EXTERNAL_MELKOR_PATH/package/melkor-storage/Config.in"
source "$BR2_EXTERNAL_MELKOR_PATH/package/melkor-installer/Config.in"

config BR2_MELKOR_LIVE_BUILTIN_FIRMWARE
	bool "Embed firmware for the Intel AX200 in the Live kernel"
	depends on BR2_LINUX_KERNEL
	depends on BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22260
	depends on BR2_PACKAGE_WIRELESS_REGDB
	help
	  Use the verified firmware packages to make the AX200 firmware
	  and the signed regulatory database available for early probing.
