#!/bin/sh
set -eu

runtime=/opt/melkor-desktop
umask 077
scratch=$(mktemp -d /tmp/melkor-greeter.XXXXXX)
trap 'rm -rf -- "$scratch"' EXIT
export XDG_RUNTIME_DIR="$scratch"
export XDG_CACHE_HOME="$scratch"
export LIBSEAT_BACKEND=seatd
export LIBINPUT_QUIRKS_DIR="$runtime/usr/share/libinput"
export LIBGL_DRIVERS_PATH="$runtime/usr/lib/dri"
export GBM_BACKENDS_PATH="$runtime/usr/lib/gbm"
export XKB_CONFIG_ROOT="$runtime/usr/share/X11/xkb"
export WLR_RENDERER=pixman
export LANG=C.UTF-8
dbus-run-session -- "$runtime/usr/bin/cage" -s -- \
    "$runtime/usr/bin/noctalia-greeter" --session melkor-umbriel --user melkor
