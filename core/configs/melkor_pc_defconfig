BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_VERSION_14_X=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_REPRODUCIBLE=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

BR2_TARGET_GENERIC_HOSTNAME="melkor"
BR2_TARGET_GENERIC_ISSUE="Melkor Linux PC"
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_MELKOR_PATH)/board/pc/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MELKOR_PATH)/board/m0/rootfs-overlay $(BR2_EXTERNAL_MELKOR_PATH)/board/network/rootfs-overlay $(BR2_EXTERNAL_MELKOR_PATH)/board/m1/rootfs-overlay $(BR2_EXTERNAL_MELKOR_PATH)/board/live/rootfs-overlay $(BR2_EXTERNAL_MELKOR_PATH)/board/pc/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MELKOR_PATH)/board/m1/post-build.sh $(BR2_EXTERNAL_MELKOR_PATH)/board/pc/post-build.sh"

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/x86_64/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MELKOR_PATH)/board/m0/linux.fragment $(BR2_EXTERNAL_MELKOR_PATH)/board/live/linux.fragment $(BR2_EXTERNAL_MELKOR_PATH)/board/m1/linux.fragment $(BR2_EXTERNAL_MELKOR_PATH)/board/pc/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MELKOR_PATH)/board/m0/busybox.fragment $(BR2_EXTERNAL_MELKOR_PATH)/board/m1/busybox.fragment"
BR2_PACKAGE_DINIT=y
BR2_PACKAGE_DNSPROXY=y
BR2_PACKAGE_MELKOR_DHCPCD=y
BR2_PACKAGE_MELKOR_STORAGE=y
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_SETPRIV=y
BR2_PACKAGE_IWD=y
BR2_PACKAGE_READLINE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22260=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_MELKOR_LIVE_BUILTIN_FIRMWARE=y

BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_DEJAVU=y

BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux fat part_gpt normal serial terminal regexp squash4 loadenv test"
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_RAUC=y
